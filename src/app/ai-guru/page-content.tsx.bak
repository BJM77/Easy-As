import { Loader2, Sparkles, Settings, MapPin, Package, BarChart, FileText, Info, Printer, ArrowRight, Table as TableIcon, Download, CheckSquare, RefreshCcw, PlusCircle, Trash2, Mic, Bot, Edit, X, History, Mail, Send, Package as PackageIcon, Building, Phone, User as UserIcon, Calendar as CalendarIcon, FileSignature, UploadCloud } from 'lucide-react';
