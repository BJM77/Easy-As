import { z } from 'zod';
import type { PostcodeData, FreightFormValues, CalculatedPriceItem, ServiceName, RateCardDisplayEntry, PEZonesEntry, RegionalLookupEntry, B2BRdexEntry, B2BPriorityRateEntry, LCPRdexRateEntry, LCPPrioRateEntry, TieredPalletRateEntry, WestEastRateEntry, B2CRateEntry, RateFileType, ProposalDetails, ProposalSection, ProposalSectionId } from '@/lib/types';
