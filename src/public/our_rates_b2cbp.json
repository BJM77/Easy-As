"use client";

import React, { useState, useRef, useCallback } from 'react';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { z } from 'zod';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { useToast } from '@/hooks/use-toast';
import { Loader2, UploadCloud, FileJson, CheckCircle, XCircle, Download, FileArchive, ClipboardPaste, Eye, ChevronDown, ChevronUp } from 'lucide-react';
import { useRateOverrides } from '@/context/RateOverrideContext';
import type { RateFileType, RateData } from '@/lib/types';
import * as XLSX from 'xlsx';
import { ScrollArea } from '@/components/ui/scroll-area';
import JSZip from 'jszip';
import { Textarea } from '@/components/ui/textarea';
import {
  AlertDialog,
  AlertDialogAction,
  AlertDialogContent,
  AlertDialogDescription,
  AlertDialogFooter,
  AlertDialogHeader,
  AlertDialogTitle,
} from "@/components/ui/alert-dialog";
import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from '@/components/ui/accordion';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';

const fileUploadSchema = z.object({
  our_rates_b2brdex: z.custom<FileList>().optional(),
  our_rates_b2b_priority: z.custom<FileList>().optional(),
  our_rates_pe: z.custom<FileList>().optional(),
  our_rates_b2c: z.custom<FileList>().optional(),
  our_rates_lcprdex: z.custom<FileList>().optional(),
  our_rates_lcpprio: z.custom<FileList>().optional(),
  our_rates_lcpgo: z.custom<FileList>().optional(),
  our_rates_west_east: z.custom<FileList>().optional(),
});

type FileUploadFormValues = z.infer<typeof fileUploadSchema>;
type PriorityDataType = 'PriorityB2B' | 'PrioritySatchel' | 'B2CPriority' | 'B2CStandard';

const fileTypeMapping: Record<keyof FileUploadFormValues, RateFileType> = {
  our_rates_b2brdex: 'our_rates_b2brdex',
  our_rates_b2b_priority: 'our_rates_b2b_priority',
  our_rates_pe: 'our_rates_pe',
  our_rates_b2c: 'our_rates_b2c',
  our_rates_lcprdex: 'our_rates_lcprdex',
  our_rates_lcpprio: 'our_rates_lcpprio',
  our_rates_lcpgo: 'our_rates_lcpgo',
  our_rates_west_east: 'our_rates_west_east',
};

const fileLabels: Record<keyof FileUploadFormValues, string> = {
  our_rates_b2brdex: 'B2B Road Express (our_rates_b2brdex.json)',
  our_rates_b2b_priority: 'B2B Priority (our_rates_b2b_priority.json)',
  our_rates_pe: 'Pallet Rates (our_rates_pe.json)',
  our_rates_b2c: 'B2C Rates (our_rates_b2c.json)',
  our_rates_lcprdex: 'LCP Road (our_rates_lcprdex.json)',
  our_rates_lcpprio: 'LCP Priority (our_rates_lcpprio.json)',
  our_rates_lcpgo: 'LCP GO (our_rates_lcpgo.json)',
  our_rates_west_east: 'West-East Rates (our_rates_west_east.json)',
};

const fileTemplates: Record<keyof FileUploadFormValues, string> = {
    our_rates_b2brdex: "Product,Service,Source,Destination,BasicUnitAmount,BasicChargeAmount,Price per Kilogram,Minimum,Return (Y/N),Cubic,RangeStart,RangeEnd\nParcel,X,PER,ABX,0,14.67,0.65,17.89,N,250,0,99999\n",
    our_rates_b2b_priority: "Service,From,To,Basic,Kilo Rate Thereafter\nPriority,SYD,MEL,33.52,18.83\n",
    our_rates_pe: "Service,From,To,Basic,Minimum,0-250,251-750,751-1500,1501-3000,3001-5000,5001-99999\nPallet Express,METRO,METRO,55,55,0.08,0.07,0.06,0.05,0.04,0.03\n",
    our_rates_b2c: "Journey,b2c1,b2c3,b2c5,kg,b2cp1,b2cp3,b2cp5,pkg\nSYDMEL,10,12,14,0.5,12,14,16,0.6\n",
    our_rates_lcprdex: "Logic,LCPRDEXBasic,LCPRDEXKg\nLCPRDEXSYDMEL,12,0.4\n",
    our_rates_lcpprio: "Logic,LCPPrioBasic,LCPPrioKg\nLCPPrioSYDMEL,15,0.5\n",
    our_rates_lcpgo: "Logic,Go1,Go3,Go5,Go10\nGoOff PeakSYDMEL,8,10,12,15\n",
    our_rates_west_east: "From,To,Service,Reciprocal,Basic,Minimum,0-99999KGS\nPER,SYDNEY,PE,N,100,100,0.5\n"
};

const zoneIdToCodeMap: Record<string, string> = {
  "200": "SYD", "210": "ABX", "211": "CBR", "212": "NTL", "213": "WOL",
  "201": "NSW1", "202": "NSW2", "203": "NSW3", "204": "NSW4", "205": "NSW5",
  "206": "NSW6", "207": "NSW7", "208": "NSW8", "209": "NSW9", "300": "MEL",
  "301": "VIC1", "302": "VIC2", "400": "BNE", "410": "CNS", "411": "MKY",
  "412": "ROK", "413": "TSV", "414": "YORK", "401": "QLD1", "402": "QLD2",
  "403": "QLD3", "404": "QLD4", "405": "QLD5", "406": "QLD6", "407": "QLD7",
  "408": "QLD8", "409": "QLD9", "500": "ADL", "501": "SA1", "502": "SA2",
  "503": "SA3", "504": "SA4", "505": "SA5", "600": "PER", "601": "WA1",
  "602": "WA2", "603": "WA3", "604": "WA4", "800": "DRW", "802": "ASP",
  "801": "NT1", "700": "HBA", "704": "LST", "701": "TAS1", "702": "TAS2", "703": "TAS3",
};

export default function RateUploaderPageContent() {
  const { toast } = useToast();
  const { setRateOverride, getRateFile, overriddenRates } = useRateOverrides();
  const [isLoading, setIsLoading] = useState<Partial<Record<keyof FileUploadFormValues, boolean>>>({});
  const [isPasting, setIsPasting] = useState(false);
  const [previews, setPreviews] = useState<Partial<Record<keyof FileUploadFormValues, RateData>>>({});
  const fileInputRefs = useRef<Record<keyof FileUploadFormValues, HTMLInputElement | null>>({} as any);
  const [pastedIpecData, setPastedIpecData] = useState('');
  
  const [isJsonViewerOpen, setIsJsonViewerOpen] = useState(false);
  const [jsonViewerContent, setJsonViewerContent] = useState('');
  
  const [pastedPriorityData, setPastedPriorityData] = useState('');
  const [pastedPalletData, setPastedPalletData] = useState('');
  const [priorityDataType, setPriorityDataType] = useState<PriorityDataType>('PriorityB2B');
  const [accordionState, setAccordionState] = useState({ ipec: true, priority: false, pallet: false });

  const toggleAccordion = (key: 'ipec' | 'priority' | 'pallet') => {
    setAccordionState(prev => ({ ...prev, [key]: !prev[key] }));
  };


  const processAndSetData = useCallback((fileKey: keyof FileUploadFormValues, data: any[], isFromPaste: boolean = false) => {
    const rateFileType = fileTypeMapping[fileKey];
    let transformedData: any[] = data;

    if (rateFileType === 'our_rates_b2brdex' && isFromPaste) {
        transformedData = data.map(row => ({
          Logic: `Parcel${row['Source']}${row['Dest']}`,
          B1: parseFloat(row['Basic Charge']?.replace('$', '')) || null,
          K1: parseFloat(row['Freight Charge']?.replace('$', '')) || null,
          M1: parseFloat(row['Minimum Charge']?.replace('$', '')) || null,
        }));
        setJsonViewerContent(JSON.stringify(transformedData, null, 2));
    } else if (rateFileType === 'our_rates_b2b_priority') {
      transformedData = data.map(row => ({
        Logic: `02 02${row.From}${row.To}`,
        B1: Number(row.Basic),
        K1: Number(row["Kilo Rate Thereafter"]),
      }));
    } else if (rateFileType === 'our_rates_b2c') {
      transformedData = data;
    } else if (rateFileType === 'our_rates_pe') {
      transformedData = data.map(row => ({
        "From - To": `${row.From}${row.To}`,
        "From": row.From,
        "To": row.To,
        "EBasic": Number(row.Basic), "Eminimum": Number(row.Minimum), "E0 - 250": Number(row['0-250']),
        "E251 - 750": Number(row['251-750']), "E751 - 1500": Number(row['751-1500']),
        "E1501 - 3000": Number(row['1501-3000']), "E3001-5000": Number(row['3001-5000']), "E5001 - 99999": Number(row['5001-99999']),
        "GBasic": Number(row.Basic), "GMinimum": Number(row.Minimum), "G0 - 250": Number(row['0-250']),
        "G251 - 750": Number(row['251-750']), "G751 - 1500": Number(row['751-1500']),
        "G1501 - 3000": Number(row['1501-3000']), "G3001-5000": Number(row['3001-5000']), "G5001 - 99999": Number(row['5001-99999']),
      }));
    }

    setRateOverride(rateFileType, transformedData as RateData);
    setPreviews(prev => ({ ...prev, [fileKey]: transformedData.slice(0, 5) }));
    toast({ title: 'Success', description: `${fileKey} rates have been loaded and applied for this session.` });
  }, [setRateOverride, toast]);


  const handleFileChange = async (fileKey: keyof FileUploadFormValues, file: File) => {
    setIsLoading(prev => ({ ...prev, [fileKey]: true }));
    try {
        const reader = new FileReader();
        reader.onload = (e) => {
            const data = e.target?.result;
            if (typeof data !== 'string' && !(data instanceof ArrayBuffer)) {
              toast({ title: 'Error reading file', variant: 'destructive' });
              setIsLoading(prev => ({ ...prev, [fileKey]: false }));
              return;
            }
            const workbook = XLSX.read(data, { type: 'binary' });
            const sheetName = workbook.SheetNames[0];
            const worksheet = workbook.Sheets[sheetName];
            const jsonData = XLSX.utils.sheet_to_json(worksheet);
            processAndSetData(fileKey, jsonData);
        };
        reader.readAsBinaryString(file);
    } catch (error) {
      toast({ title: 'Processing Error', description: `Failed to process ${file.name}.`, variant: 'destructive' });
    } finally {
      setIsLoading(prev => ({ ...prev, [fileKey]: false }));
    }
  };

  const handleDownloadTemplate = (fileKey: keyof FileUploadFormValues) => {
    const content = fileTemplates[fileKey];
    const blob = new Blob([content], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `${fileKey}_template.csv`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  };
  
  const handleDownloadAllAsZip = async () => {
    const zip = new JSZip();
    let filesAdded = 0;

    for (const key in fileTypeMapping) {
      const rateFileType = fileTypeMapping[key as keyof FileUploadFormValues];
      const data = getRateFile(rateFileType);
      if (data && Array.isArray(data) && data.length > 0) {
        const fileName = `${rateFileType}.json`;
        zip.file(fileName, JSON.stringify(data, null, 2));
        filesAdded++;
      }
    }
    
    if (filesAdded === 0) {
      toast({ title: "No Rates to Download", description: "No custom rates are currently loaded.", variant: "default" });
      return;
    }

    try {
      const content = await zip.generateAsync({ type: "blob" });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(content);
      link.download = "justeasy_rate_overrides.zip";
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(link.href);
      toast({ title: "Download Started", description: `Zipping and downloading ${filesAdded} rate file(s).`});
    } catch(e) {
      console.error("Failed to generate zip", e);
      toast({ title: "Zip Error", description: "Could not create the zip file.", variant: "destructive"});
    }
  };
  
  const handleProcessPastedIpec = () => {
    setIsPasting(true);
    setJsonViewerContent('');
    try {
        const lines = pastedIpecData.trim().split('\n');
        if (lines.length === 0) throw new Error("No data lines found.");

        const headerLine = lines[0].toLowerCase();
        if (!headerLine.includes('service') || !headerLine.includes('source') || !headerLine.includes('dest')) {
            throw new Error("Pasted data does not contain expected IPEC headers (Service, Source, Dest).");
        }

        const dataRows = lines.slice(1);
        if (dataRows.length === 0) throw new Error("No data rows found after the header.");

        const parsedData = dataRows.map(line => {
            const parts = line.split(/\t/); // Split by tab
            if (parts.length < 11 || parts[0]?.trim().toUpperCase() !== 'RDEX') return null;

            return {
                'Source': parts[1]?.trim(),
                'Dest': parts[2]?.trim(),
                'Basic Charge': parts[4]?.trim(),
                'Freight Charge': parts[8]?.trim(),
                'Minimum Charge': parts[9]?.trim(),
            };
        }).filter(Boolean);
      
        if (parsedData.length > 0) {
            processAndSetData('our_rates_b2brdex', parsedData, true);
        } else {
            throw new Error("No valid RDEX data rows could be parsed. Check data format.");
        }
    } catch (e) {
        toast({ title: "Parsing Error", description: e instanceof Error ? e.message : "An error occurred while processing pasted data.", variant: "destructive" });
    } finally {
        setIsPasting(false);
    }
  };

  const handleProcessPastedPriority = () => {
    setIsPasting(true);
    try {
        const lines = pastedPriorityData.trim().split('\n');
        if (lines.length === 0) throw new Error("No data found to process.");

        const parsedData: any[] = lines.map(line => {
            const parts = line.split(/\t/);
            if (parts.length < 14) return null; // Minimum columns for B2B prio
            return {
                Product: parts[1]?.trim(),
                Service: parts[3]?.trim(),
                From: zoneIdToCodeMap[parts[5]?.trim()] || parts[5]?.trim(),
                To: zoneIdToCodeMap[parts[6]?.trim()] || parts[6]?.trim(),
                Basic: parts[11]?.trim(),
                "Kilo Rate Thereafter": parts[13]?.trim(),
                b2c1kg: parts[17]?.trim(),
                b2c3kg: parts[19]?.trim(),
                b2c5kg: parts[21]?.trim(),
                b2cPerKg: parts[23]?.trim(),
            };
        }).filter(Boolean);
        
        let targetFileType: RateFileType;
        let finalData: any[];

        if (priorityDataType === 'PriorityB2B') {
            finalData = parsedData.filter(row => row.Product === '02' && row.Service === '02');
            targetFileType = 'our_rates_b2b_priority';
            if (finalData.length > 0) processAndSetData(targetFileType as keyof FileUploadFormValues, finalData);
        } else if (priorityDataType === 'B2CStandard' || priorityDataType === 'B2CPriority') {
            const b2cProductCodes = ['SH', 'M7', 'SF', 'SG', 'K5', 'M5', 'M6', 'ET', 'EU', 'EV', 'EW'];
            const journeyMap = new Map<string, any>();

            parsedData.filter(row => b2cProductCodes.includes(row.Product)).forEach(row => {
                const journeyKey = `${row.From}-${row.To}`;
                if (!journeyMap.has(journeyKey)) {
                    journeyMap.set(journeyKey, { Journey: `${row.From}${row.To}` });
                }
                const entry = journeyMap.get(journeyKey);
                const isStandard = row.Service === 'BS';

                if (priorityDataType === 'B2CStandard' && isStandard) {
                    if (row.Product === 'SH') entry.kg = parseFloat(row.b2cPerKg?.replace('$', '')) || 0;
                    else if (row.Product === 'SD') entry.b2c1 = parseFloat(row.b2c1kg?.replace('$', '')) || 0;
                    else if (row.Product === 'SF') entry.b2c3 = parseFloat(row.b2c3kg?.replace('$', '')) || 0;
                    else if (row.Product === 'SG') entry.b2c5 = parseFloat(row.b2c5kg?.replace('$', '')) || 0;
                } else if (priorityDataType === 'B2CPriority' && !isStandard) {
                     if (row.Product === 'M7') entry.pkg = parseFloat(row.b2cPerKg?.replace('$', '')) || 0;
                    else if (row.Product === 'K5') entry.b2cp1 = parseFloat(row.b2c1kg?.replace('$', '')) || 0;
                    else if (row.Product === 'M5') entry.b2cp3 = parseFloat(row.b2c3kg?.replace('$', '')) || 0;
                    else if (row.Product === 'M6') entry.b2cp5 = parseFloat(row.b2c5kg?.replace('$', '')) || 0;
                }
            });
            finalData = Array.from(journeyMap.values());
            targetFileType = 'our_rates_b2c';
            if (finalData.length > 0) processAndSetData(targetFileType as keyof FileUploadFormValues, finalData);
        } else {
            toast({ title: "In Development", description: `Parser for ${priorityDataType} is not yet fully implemented.` });
            setIsPasting(false);
            return;
        }

        if (finalData.length > 0) {
            toast({ title: 'Success', description: `${finalData.length} rates processed for ${priorityDataType}.` });
        } else {
            toast({ title: 'No Data Found', description: `No matching rows found for the selected Priority type.`, variant: 'destructive' });
        }

    } catch (e) {
        toast({ title: "Parsing Error", description: e instanceof Error ? e.message : "Error processing pasted data.", variant: "destructive" });
    } finally {
        setIsPasting(false);
    }
  };

  const handleProcessPastedPallet = () => {
    toast({ title: "In Development", description: "Parsing for Pallet data is coming soon!"});
  };

  return (
    <div className="space-y-8">
      <Card className="shadow-xl">
        <CardHeader>
          <div className="flex flex-col md:flex-row justify-between items-start gap-4">
            <div>
              <CardTitle className="text-2xl font-headline flex items-center">
                <UploadCloud className="mr-2 h-7 w-7 text-primary" /> Customer Rate Uploader
              </CardTitle>
              <CardDescription>
                Paste data directly from rate cards. Rates are applied to the "Our Rates" spend band for your session.
              </CardDescription>
            </div>
             <Button onClick={handleDownloadAllAsZip}>
              <FileArchive className="mr-2 h-4 w-4"/> Download All as Zip
            </Button>
          </div>
        </CardHeader>
      </Card>
      
      <div className="space-y-4">
        <Card>
            <CardHeader className="flex flex-row items-center justify-between cursor-pointer" onClick={() => toggleAccordion('ipec')}>
                <CardTitle className="text-lg font-semibold">IPEC RDEX Data (our_rates_b2brdex.json)</CardTitle>
                {accordionState.ipec ? <ChevronUp/> : <ChevronDown/>}
            </CardHeader>
            {accordionState.ipec && (
              <CardContent>
                  <Textarea value={pastedIpecData} onChange={(e) => setPastedIpecData(e.target.value)} placeholder="Paste the full text block from your IPEC rate card (including the header)..." rows={8} />
                  <div className="flex flex-wrap gap-2 mt-2">
                      <Button onClick={handleProcessPastedIpec} disabled={isPasting}>
                          {isPasting ? <Loader2 className="mr-2 h-4 w-4 animate-spin"/> : <ClipboardPaste className="mr-2 h-4 w-4"/>}
                          Process Pasted IPEC Data
                      </Button>
                      <Button variant="outline" onClick={() => setIsJsonViewerOpen(true)} disabled={!jsonViewerContent}>
                          <Eye className="mr-2 h-4 w-4" /> View JSON
                      </Button>
                  </div>
              </CardContent>
            )}
        </Card>
        <Card>
            <CardHeader className="flex flex-row items-center justify-between cursor-pointer" onClick={() => toggleAccordion('priority')}>
                <CardTitle className="text-lg font-semibold">Priority Data</CardTitle>
                {accordionState.priority ? <ChevronUp/> : <ChevronDown/>}
            </CardHeader>
            {accordionState.priority && (
              <CardContent>
                  <Textarea value={pastedPriorityData} onChange={(e) => setPastedPriorityData(e.target.value)} placeholder="Paste the raw text block from your Priority rate card..." rows={8} />
                  <div className="flex flex-wrap gap-2 mt-2 items-end">
                      <div className="flex-grow space-y-1">
                          <Label htmlFor="priority-data-type">Target Rate File</Label>
                          <Select value={priorityDataType} onValueChange={v => setPriorityDataType(v as PriorityDataType)}>
                              <SelectTrigger id="priority-data-type"><SelectValue/></SelectTrigger>
                              <SelectContent>
                                  <SelectItem value="PriorityB2B">B2B Priority (our_rates_b2b_priority.json)</SelectItem>
                                  <SelectItem value="B2CStandard">B2C Standard (our_rates_b2c.json)</SelectItem>
                                  <SelectItem value="B2CPriority">B2C Priority (our_rates_b2c.json)</SelectItem>
                                  <SelectItem value="PrioritySatchel">B2B Satchel (our_rates_b2bsatchel.json)</SelectItem>
                              </SelectContent>
                          </Select>
                      </div>
                      <Button onClick={handleProcessPastedPriority} disabled={isPasting}>
                          {isPasting ? <Loader2 className="mr-2 h-4 w-4 animate-spin"/> : <ClipboardPaste className="mr-2 h-4 w-4"/>}
                          Process Priority Data
                      </Button>
                  </div>
              </CardContent>
            )}
        </Card>
         <Card>
            <CardHeader className="flex flex-row items-center justify-between cursor-pointer" onClick={() => toggleAccordion('pallet')}>
                <CardTitle className="text-lg font-semibold">Palletised Express Data (our_rates_pe.json)</CardTitle>
                {accordionState.pallet ? <ChevronUp/> : <ChevronDown/>}
            </CardHeader>
            {accordionState.pallet && (
              <CardContent>
                  <Textarea value={pastedPalletData} onChange={(e) => setPastedPalletData(e.target.value)} placeholder="Paste the raw text block from your Palletised Express rate card..." rows={8} />
                  <div className="flex flex-wrap gap-2 mt-2">
                      <Button onClick={handleProcessPastedPallet} disabled={true}>
                          <ClipboardPaste className="mr-2 h-4 w-4"/>
                          Process Pallet Data (In Dev)
                      </Button>
                  </div>
              </CardContent>
            )}
        </Card>
      </div>

       <AlertDialog open={isJsonViewerOpen} onOpenChange={setIsJsonViewerOpen}>
        <AlertDialogContent className="max-w-2xl">
          <AlertDialogHeader>
            <AlertDialogTitle>Generated JSON for our_rates_b2brdex.json</AlertDialogTitle>
            <AlertDialogDescription>
              This is the JSON generated from the pasted data. It has been applied as an override for this session.
            </AlertDialogDescription>
          </AlertDialogHeader>
          <ScrollArea className="h-[60vh] w-full rounded-md border p-4 bg-background">
            <pre className="text-xs whitespace-pre-wrap">{jsonViewerContent}</pre>
          </ScrollArea>
          <AlertDialogFooter>
            <AlertDialogAction onClick={() => setIsJsonViewerOpen(false)}>Close</AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialogContent>
      </AlertDialog>
    </div>
  );
}