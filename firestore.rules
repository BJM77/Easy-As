
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /*
    |--------------------------------------------------------------------------
    | CORE AUTHORIZATION FUNCTIONS
    |--------------------------------------------------------------------------
    */

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.role == "superadmin" ||
        request.auth.token.email in [
          "benjamin.mackie@teamglobalexp.com",
          "bjmack22277@gmail.com",
          "1@1.com",
          "urika@urika.com.au"
        ]
      );
    }

    function hasCompanyAccess(companyId) {
      return isSignedIn() && (
        request.auth.token.companyId == companyId ||
        (request.auth.token.assignedCompanyIds != null && companyId in request.auth.token.assignedCompanyIds)
      );
    }

    /*
    |--------------------------------------------------------------------------
    | COLLECTION RULES
    |--------------------------------------------------------------------------
    */

    // Global Rates (System-wide core rate overrides)
    match /globalRates/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Companies (Tenant metadata)
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Tenant-isolated collections
    match /problems/{id} {
      allow read, update: if isSuperAdmin() || hasCompanyAccess(resource.data.companyId);
      allow create: if isSuperAdmin() || hasCompanyAccess(request.resource.data.companyId);
    }

    match /leads/{id} {
      allow read: if isSuperAdmin() || hasCompanyAccess(resource.data.companyId);
      allow create: if isSuperAdmin() || hasCompanyAccess(request.resource.data.companyId);
    }

    match /ai_quotes/{id} {
      allow read: if isSuperAdmin() || hasCompanyAccess(resource.data.companyId);
      allow create: if isSuperAdmin() || hasCompanyAccess(request.resource.data.companyId);
    }

    match /companyRates/{id} {
      allow read: if isSuperAdmin() || hasCompanyAccess(resource.data.companyId);
    }

    match /vipContacts/{id} {
      allow read: if isSuperAdmin() || hasCompanyAccess(resource.data.companyId);
      allow write: if isSuperAdmin() || hasCompanyAccess(request.resource.data.companyId);
    }

    match /deliveryRuns/{id} {
      allow read: if isSuperAdmin() || hasCompanyAccess(resource.data.companyId);
      allow write: if isSuperAdmin() || hasCompanyAccess(request.resource.data.companyId);
    }

    match /tgeAccountApplications/{id} {
      allow read: if isSuperAdmin() || hasCompanyAccess(resource.data.companyId);
      allow create: if isSuperAdmin() || hasCompanyAccess(request.resource.data.companyId);
    }

    match /invitations/{id} {
      allow read: if true; 
      allow write: if isSuperAdmin() || hasCompanyAccess(request.resource.data.companyId);
    }

    match /notes/{id} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        resource == null ||
        request.auth.uid == resource.data.userId
      );
      allow write: if isSignedIn() && (
        isSuperAdmin() || 
        request.auth.uid == request.resource.data.userId
      );
    }

    match /quote_logs/{id} {
        allow create: if isSignedIn();
        allow read: if isSuperAdmin();
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId; 
      allow update: if isSuperAdmin() || (
        request.auth.uid == userId && 
        request.resource.data.role == resource.data.role &&
        request.resource.data.companyId == resource.data.companyId
      );
    }

    // Audit Logs (Superadmin Only)
    match /audit_logs/{id} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn();
    }

    match /ai_usage_log/{id} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn();
    }

    // Root-level bypass for superadmins
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
